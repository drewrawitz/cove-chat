datasource db {
  provider = "postgresql"
}

generator zero {
  provider      = "prisma-zero"
  output        = "../../sync/src/generated"
  camelCase     = true
  excludeTables = ["User", "MagicLink", "Session", "AuditEvent", "WorkspaceInvitation", "MessageRevision", "MessageCommandReceipt"]
}

enum WorkspaceRole {
  OWNER  @map("owner")
  ADMIN  @map("admin")
  MEMBER @map("member")
  GUEST  @map("guest")
}

enum ChannelVisibility {
  PUBLIC  @map("public")
  PRIVATE @map("private")
}

enum TopicIntent {
  QUESTION   @map("question")
  PROPOSAL   @map("proposal")
  DECISION   @map("decision")
  UPDATE     @map("update")
  DISCUSSION @map("discussion")
}

model User {
  id                  String                @id
  email               String                @unique
  displayName         String                @map("display_name")
  workspaceIdentities WorkspaceIdentity[]
  magicLinks          MagicLink[]
  sessions            Session[]
  auditEvents         AuditEvent[]
  invitationsSent     WorkspaceInvitation[] @relation("WorkspaceInvitationInviter")
  invitationsAccepted WorkspaceInvitation[] @relation("WorkspaceInvitationAccepter")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("users")
}

model MagicLink {
  tokenHash  String    @id @map("token_hash")
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([expiresAt])
  @@map("magic_links")
}

model Session {
  tokenHash     String   @id @map("token_hash")
  csrfTokenHash String   @unique @map("csrf_token_hash")
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditEvent {
  id           String   @id
  eventType    String   @map("event_type")
  eventVersion Int      @map("event_version")
  actorUserId  String   @map("actor_user_id")
  actor        User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(6)
  metadata     Json     @db.JsonB

  @@index([actorUserId, occurredAt])
  @@map("audit_events")
}

model Workspace {
  id                     String                  @id
  name                   String
  identities             WorkspaceIdentity[]
  channels               Channel[]
  invitations            WorkspaceInvitation[]
  messageCommandReceipts MessageCommandReceipt[]
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("workspaces")
}

model WorkspaceInvitation {
  id                  String        @id
  workspaceId         String        @map("workspace_id")
  inviteeEmail        String        @map("invitee_email")
  invitedByAccountId  String        @map("invited_by_account_id")
  acceptedByAccountId String?       @map("accepted_by_account_id")
  tokenHash           String        @unique @map("token_hash")
  tokenExpiresAt      DateTime      @map("token_expires_at") @db.Timestamptz(6)
  role                WorkspaceRole @default(MEMBER)
  invitedAt           DateTime      @default(now()) @map("invited_at") @db.Timestamptz(6)
  acceptedAt          DateTime?     @map("accepted_at") @db.Timestamptz(6)
  workspace           Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy           User          @relation("WorkspaceInvitationInviter", fields: [invitedByAccountId], references: [id], onDelete: Restrict)
  acceptedBy          User?         @relation("WorkspaceInvitationAccepter", fields: [acceptedByAccountId], references: [id], onDelete: Restrict)

  @@index([inviteeEmail, acceptedAt])
  @@index([acceptedByAccountId])
  @@index([tokenExpiresAt])
  @@index([workspaceId, acceptedAt])
  @@map("workspace_invitations")
}

model WorkspaceIdentity {
  id                  String
  workspaceId         String              @map("workspace_id")
  accountId           String              @map("account_id")
  name                String
  avatarUrl           String              @map("avatar_url")
  role                WorkspaceRole       @default(MEMBER)
  membershipStartedAt DateTime            @default(now()) @map("membership_started_at") @db.Timestamptz(6)
  membershipEndedAt   DateTime?           @map("membership_ended_at") @db.Timestamptz(6)
  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account             User                @relation(fields: [accountId], references: [id], onDelete: Restrict)
  channelMemberships  ChannelMembership[]
  maintainedChannels  Channel[]           @relation("ChannelMaintainer")
  openedTopics        Topic[]             @relation("TopicOpener")
  latestMessageTopics Topic[]             @relation("TopicLatestMessageAuthor")
  messages            Message[]           @relation("MessageAuthor")
  messageCommands     MessageCommandReceipt[]
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([workspaceId, id])
  @@unique([workspaceId, accountId])
  @@index([accountId])
  @@index([workspaceId, membershipEndedAt])
  @@map("workspace_identities")
}

model Channel {
  id                   String
  workspaceId          String               @map("workspace_id")
  name                 String
  purpose              String               @default("Purpose not recorded.")
  visibility           ChannelVisibility    @default(PUBLIC)
  maintainerIdentityId String               @map("maintainer_identity_id")
  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  maintainer           WorkspaceIdentity    @relation("ChannelMaintainer", fields: [workspaceId, maintainerIdentityId], references: [workspaceId, id], onDelete: Restrict)
  memberships          ChannelMembership[]
  topics               Topic[]
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([workspaceId, id])
  @@index([workspaceId, visibility])
  @@index([workspaceId, maintainerIdentityId])
  @@map("channels")
}

model ChannelMembership {
  workspaceId       String            @map("workspace_id")
  channelId         String            @map("channel_id")
  identityId        String            @map("identity_id")
  channel           Channel           @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Cascade)
  workspaceIdentity WorkspaceIdentity @relation(fields: [workspaceId, identityId], references: [workspaceId, id], onDelete: Cascade)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([workspaceId, channelId, identityId])
  @@index([workspaceId, identityId])
  @@map("channel_memberships")
}

model Topic {
  id                              String
  workspaceId                     String            @map("workspace_id")
  channelId                       String            @map("channel_id")
  title                           String
  intent                          TopicIntent?
  openedByIdentityId              String            @map("opened_by_identity_id")
  messageCount                    Int               @map("message_count")
  latestMessageId                 String            @map("latest_message_id")
  latestMessagePreview            String?           @map("latest_message_preview")
  latestMessageAuthorIdentityId   String            @map("latest_message_author_identity_id")
  latestMessagePosition           Int               @map("latest_message_position")
  latestMessageCreatedAt          DateTime          @map("latest_message_created_at") @db.Timestamptz(6)
  latestMessageEditedAt           DateTime?         @map("latest_message_edited_at") @db.Timestamptz(6)
  latestMessageDeletedAt          DateTime?         @map("latest_message_deleted_at") @db.Timestamptz(6)
  lastActivityAt                  DateTime          @map("last_activity_at") @db.Timestamptz(6)
  channel                         Channel           @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Cascade)
  openedBy                        WorkspaceIdentity @relation("TopicOpener", fields: [workspaceId, openedByIdentityId], references: [workspaceId, id], onDelete: Restrict)
  latestMessageAuthor             WorkspaceIdentity @relation("TopicLatestMessageAuthor", fields: [workspaceId, latestMessageAuthorIdentityId], references: [workspaceId, id], onDelete: Restrict, map: "topics_latest_message_author_fkey")
  messages                        Message[]
  createdAt                       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([workspaceId, id])
  @@index([workspaceId, channelId, createdAt])
  @@index([workspaceId, channelId, lastActivityAt(sort: Desc), id], map: "topics_channel_activity_idx")
  @@index([workspaceId, openedByIdentityId])
  @@index([workspaceId, latestMessageAuthorIdentityId], map: "topics_latest_message_author_idx")
  @@map("topics")
}

model Message {
  id                    String
  workspaceId           String                 @map("workspace_id")
  topicId               String                 @map("topic_id")
  authorIdentityId      String                 @map("author_identity_id")
  body                  String?
  position              Int
  version               Int                    @default(1)
  /// Constrained by a partial-column ON DELETE SET NULL foreign key in the SQL migration.
  producedByCommandId   String?                @map("produced_by_command_id")
  topic                 Topic                  @relation(fields: [workspaceId, topicId], references: [workspaceId, id], onDelete: Cascade)
  author                WorkspaceIdentity      @relation("MessageAuthor", fields: [workspaceId, authorIdentityId], references: [workspaceId, id], onDelete: Restrict)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  editedAt              DateTime?              @map("edited_at") @db.Timestamptz(6)
  deletedAt             DateTime?              @map("deleted_at") @db.Timestamptz(6)
  revisions             MessageRevision[]

  @@id([workspaceId, topicId, id])
  @@unique([workspaceId, topicId, position])
  @@index([workspaceId, authorIdentityId])
  @@index([workspaceId, producedByCommandId])
  @@map("messages")
}

model MessageCommandReceipt {
  workspaceId      String                  @map("workspace_id")
  commandId        String                  @map("command_id")
  actorIdentityId  String                  @map("actor_identity_id")
  kind             MessageCommandKind
  fingerprint      String
  outcome          MessageCommandOutcome   @default(pending)
  rejection        MessageCommandRejection?
  channelId        String                  @map("channel_id")
  topicId          String                  @map("topic_id")
  messageId        String?                 @map("message_id")
  messageVersion   Int?                    @map("message_version")
  workspace        Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorIdentity    WorkspaceIdentity       @relation(fields: [workspaceId, actorIdentityId], references: [workspaceId, id], onDelete: Restrict)
  createdAt        DateTime                @map("created_at") @db.Timestamptz(6)
  completedAt      DateTime?               @map("completed_at") @db.Timestamptz(6)

  @@id([workspaceId, commandId])
  @@index([workspaceId, actorIdentityId, createdAt])
  @@map("message_command_receipts")
}

enum MessageCommandKind {
  create
  edit
  delete
}

enum MessageCommandOutcome {
  pending
  succeeded
  rejected
}

enum MessageCommandRejection {
  channel_unavailable
  topic_unavailable
  message_unavailable
  mutation_forbidden
  stale_version
}

model MessageRevision {
  id          BigInt                   @id @default(autoincrement())
  workspaceId String                   @map("workspace_id")
  topicId     String                   @map("topic_id")
  messageId   String                   @map("message_id")
  body        String
  operation   MessageRevisionOperation
  revisedAt   DateTime                 @map("revised_at") @db.Timestamptz(6)
  message     Message                  @relation(fields: [workspaceId, topicId, messageId], references: [workspaceId, topicId, id], onDelete: Restrict)

  @@index([workspaceId, topicId, messageId, id])
  @@map("message_revisions")
}

enum MessageRevisionOperation {
  edit
  delete
}
